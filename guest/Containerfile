# ARM bootstrap follows the official multi-architecture Omarchy package builder
# at omacom-io/omarchy-pkgs commit 7e448b90313fea4fb78da9a78607287691d3b241.
FROM docker.io/alpine:3.21 AS bootstrapper

ARG TARGETARCH
RUN test "$TARGETARCH" = arm64

RUN apk add --no-cache bash curl gnupg pacman-makepkg zstd
COPY guest/vendor/omarchy-pkgs/pacstrap-docker /usr/local/bin/pacstrap-docker
RUN chmod 0755 /usr/local/bin/pacstrap-docker

RUN mkdir -p /etc/pacman.d /usr/share/pacman/keyrings && \
    printf '[options]\nHoldPkg = pacman glibc\nArchitecture = auto\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n\n[core]\nInclude = /etc/pacman.d/mirrorlist\n\n[extra]\nInclude = /etc/pacman.d/mirrorlist\n\n[alarm]\nInclude = /etc/pacman.d/mirrorlist\n\n[aur]\nInclude = /etc/pacman.d/mirrorlist\n' > /etc/pacman.conf && \
    curl -fsSL https://raw.githubusercontent.com/archlinuxarm/PKGBUILDs/0b5418fc3f62860b191cd872cb2f933f9fc77841/core/pacman-mirrorlist/mirrorlist -o /tmp/mirrorlist && \
    echo 'e25f0bc284287342b221377d2a0ca0203eaf13f52d369d6676c4730a8e2b1de1  /tmp/mirrorlist' | sha256sum -c - && \
    sed -E 's/^\s*#\s*Server\s*=/Server =/g; s/\$arch/aarch64/g' /tmp/mirrorlist > /etc/pacman.d/mirrorlist && \
    for pair in \
      'archlinuxarm-revoked e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' \
      'archlinuxarm-trusted f2a7250f2a2b77542f82f4219b2bae7895f27b3dcfdf350b497e2be306af776d' \
      'archlinuxarm.gpg 6ce771e853f04a38a5b533cb33e61f877b9b06b58b6db051eb8a15d737a2332f'; do \
      set -- $pair; \
      curl -fsSL "https://raw.githubusercontent.com/archlinuxarm/PKGBUILDs/0b5418fc3f62860b191cd872cb2f933f9fc77841/core/archlinuxarm-keyring/$1" -o "/usr/share/pacman/keyrings/$1"; \
      echo "$2  /usr/share/pacman/keyrings/$1" | sha256sum -c -; \
    done && \
    pacman-key --init && pacman-key --populate archlinuxarm && \
    mkdir /rootfs && pacstrap-docker /rootfs base archlinuxarm-keyring && \
    cp /etc/pacman.conf /rootfs/etc/pacman.conf && \
    cp /etc/pacman.d/mirrorlist /rootfs/etc/pacman.d/mirrorlist

FROM scratch AS builder
COPY --from=bootstrapper /rootfs/ /

RUN pacman-key --init && pacman-key --populate archlinuxarm && \
    pacman -Syu --noconfirm && \
    pacman -S --needed --noconfirm arch-install-scripts e2fsprogs git python rust=1:1.98.1-1 zstd && \
    pacman -Scc --noconfirm

WORKDIR /workspace
ENTRYPOINT ["/workspace/guest/build.sh"]
